# MongoDB
IS_LOCAL=true
MONGODB_URI=mongodb://localhost:27017

# JWT
JWT_SECRET_KEY=change-me

# Encoding: CLIENT (browser WASM) or SERVER (K8s ffmpeg queue)
VIDEO_ENCODING_STRATEGY=CLIENT
ENCODING_FFMPEG_THREADS=1
BROWSER_ENCODING_MAX_MIB=64
SERVER_UPLOAD_MAX_MIB=512
SERVER_UPLOAD_SLOTS=2
ENCODING_DISK_RESERVE_MIB=512
ENCODING_MAX_MINUTES=30
ENCODING_OUTPUT_HEIGHT=720
URL_IMPORT_HOSTS=cdn.discordapp.com,media.discordapp.net,cdn.steamusercontent.com

# Cloudflare R2
USE_R2=true
R2_ACCOUNT_ID=9d6f2289d9d11dc3d803f10c01f4a23d
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=replay-hub-videos
R2_ENDPOINT=https://9d6f2289d9d11dc3d803f10c01f4a23d.r2.cloudflarestorage.com
# Private bucket playback — presigned URLs served via /stream/* routes
API_PUBLIC_BASE_URL=https://replay-hub.theclusterflux.com
STREAM_WINDOW_SECONDS=300
STREAM_LOOKBEHIND_SECONDS=60
STREAM_PRESIGN_EXPIRY=900

# Legacy AWS S3 (migration script only)
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
S3_BUCKET_NAME=replay-hub-storage
S3_REGION=eu-central-1
